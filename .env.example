# Copy to .env and fill in. Used by docker compose (server) and by `npm run dev` (local).

# Postgres credentials (docker compose creates the DB with these)
POSTGRES_USER=english
POSTGRES_PASSWORD=change-me-to-a-long-random-password
POSTGRES_DB=english

# Host port the app is published on (127.0.0.1 only). Pick a free one if 3000 is taken.
APP_PORT=3000

# For local `npm run dev` only (inside compose the app gets its own DATABASE_URL).
# Local dev DB: `docker compose up -d db` exposes nothing, so use the dev override:
#   docker compose -f docker-compose.yml -f docker-compose.dev.yml up -d db
DATABASE_URL=postgres://english:change-me-to-a-long-random-password@127.0.0.1:5433/english
