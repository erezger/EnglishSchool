# Copy to .env and fill in. Used by docker compose (server) and by `npm run dev` (local).

# Postgres credentials (docker compose creates the DB with these)
POSTGRES_USER=english
POSTGRES_PASSWORD=change-me-to-a-long-random-password
POSTGRES_DB=english

# Host port the app is published on (127.0.0.1 only). Pick a free one if 3000 is taken.
APP_PORT=3000

# First admin account. Created on startup ONLY if no admin exists yet; changing these later does nothing
# (change the password from the app instead). The admin is attached to the existing family (imported data).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-strong-password
ADMIN_DISPLAY_NAME=אבא
# Name for the family created for the existing kids' data
FAMILY_NAME=המשפחה שלי

# Optional: lets parents auto-complete word lists (Hebrew meaning, emoji, example sentence) with Claude.
# Get a key at https://platform.claude.com — leave empty to disable (parents can still type everything).
ANTHROPIC_API_KEY=

# Session cookie "Secure" flag. Default: on in production (HTTPS). Set to false only for plain-http testing.
# COOKIE_SECURE=false

# For local `npm run dev` only (inside compose the app gets its own DATABASE_URL).
#   docker compose -f docker-compose.yml -f docker-compose.dev.yml up -d db   (Postgres on 127.0.0.1:5433)
DATABASE_URL=postgres://english:change-me-to-a-long-random-password@127.0.0.1:5433/english
